# PostgreSQL connection string.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg2://leave:leavepass@127.0.0.1:5433/leave_management

# Secret used to sign JWT access tokens. Generate a long random value
# and keep it out of version control (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret

# S3 bucket used to store uploaded leave documents.
DOCUMENT_BUCKET=your-s3-bucket-name

# AWS region for the S3 bucket.
AWS_REGION=ap-southeast-1
